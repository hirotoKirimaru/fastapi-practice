# backend/ でアプリを直接動かすとき（uv run poe start など）に読む設定。
# src/helper/config.py が作業ディレクトリの .env を読む。compose で動かすときは infra/.env を使う。

ENV=local
PROJECT_NAME="fastapi-practice"
API_V1_STR=""
SECRET="please-change-me"
GOOGLE_API_KEY=""

# ホストから infra/compose.yml の db（PostgreSQL）へつなぐとき
DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:35432/demo"

# CORS — comma-separated list (or JSON array) of additional origins
BACKEND_CORS_ORIGINS="http://localhost,http://localhost:5173,http://127.0.0.1:5173"
FRONTEND_HOST="http://localhost:5173"

# Sentry
# SENTRY_DSN=""

# SMTP (mailpit defaults: see infra/compose.yml)
# SMTP_HOST=mail
# SMTP_PORT=1025
# SMTP_TLS=false
# SMTP_SSL=false
# EMAILS_FROM_EMAIL=info@example.com
